{
  "name": "texera-agent-service",
  "version": "0.1.0",
  "description": "Texera Agent Service - AI agents for workflow manipulation",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "dev:node": "npx tsx --watch src/server.ts",
    "start": "bun run src/server.ts",
    "start:node": "npx tsx src/server.ts",
    "test": "bun test",
    "eval": "bun run eval/run.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"eval/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"eval/**/*.ts\""
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.118",
    "@elysiajs/cors": "1.4.3",
    "ai": "7.0.173",
    "ajv": "8.20.0",
    "dagre": "0.8.5",
    "elysia": "1.4.32",
    "pino": "10.4.0",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/dagre": "0.7.54",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
