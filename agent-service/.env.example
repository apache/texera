# Server
PORT=3001
API_PREFIX=/api

# LLM
LLM_API_KEY=dummy
MODEL=gpt-4-turbo

# Texera backend services
API_ENDPOINT=http://localhost:8080
MODELS_ENDPOINT=http://localhost:9096
COMPILE_ENDPOINT=http://localhost:9090
EXECUTION_ENDPOINT=http://localhost:8085

# Optional: per-CU endpoint template (k8s). {cuid} is replaced with the computing unit id.
# EXECUTION_ENDPOINT_TEMPLATE=http://computing-unit-{cuid}.texera-workflow-computing-unit-svc.texera-workflow-computing-unit-pool.svc.cluster.local:8085
