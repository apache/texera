      "operatorProperties": {
        "code": "from pytexera import *\nfrom sklearn.preprocessing import StandardScaler\n\n\nclass ProcessTableOperator(UDFTableOperator):\n\n    @overrides\n    def process_table(self, table: Table, port: int) -> Iterator[Optional[TableLike]]:\n        # TWO BUGS ON PURPOSE, to check that only the first one is fixed per round.\n        #\n        # Bug 1 (raised first): the column is \"vote_average\", not \"vote_avg\".\n        #   Raises: KeyError: 'vote_avg'\n        ratings = table[[\"vote_avg\"]]\n\n        # Bug 2 (only reachable once bug 1 is fixed): the ratings still contain\n        # missing values, so scaling fails.\n        #   Raises: ValueError: Input contains NaN.\n        ratings.loc[ratings.index % 7 == 0] = float(\"nan\")\n        table[\"rating_z\"] = StandardScaler().fit_transform(ratings)\n\n        yield table\n",
        "workers": 1,
        "retainInputColumns": true,
        "defaultEnv": true,
