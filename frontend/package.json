{
  "name": "gui",
  "version": "1.4.0-incubating-SNAPSHOT",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "concurrently --kill-others \"y-websocket\" \"vite --config vite.config.mts\"",
    "start:react": "vite --config vite.config.mts --open /react.html",
    "build": "node build-version.js && tsc --project tsconfig.json --noEmit && vite build --config vite.config.mts",
    "build:ci": "yarn build",
    "build:react": "node build-version.js && tsc --project tsconfig.json --noEmit && vite build --config vite.config.mts",
    "test": "vitest run --config vitest.react.config.mts",
    "test:react": "vitest run --config vitest.react.config.mts",
    "test:ci": "vitest run --config vitest.react.config.mts --coverage && yarn test:tools",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:tools": "node --test tools/*.spec.mjs",
    "test:e2e": "node tools/workspace-browser.mjs",
    "lint": "eslint --no-eslintrc --config .eslintrc.react.json --ext .ts,.tsx src/react && eslint --no-eslintrc --config .eslintrc.core.json --ext .ts src/core",
    "lint:react": "eslint --no-eslintrc --config .eslintrc.react.json --ext .ts,.tsx src/react",
    "eslint:fix": "eslint --no-eslintrc --config .eslintrc.react.json --ext .ts,.tsx src/react --fix && eslint --no-eslintrc --config .eslintrc.core.json --ext .ts src/core --fix",
    "prettier:fix": "prettier --write \"src/react/**/*.{ts,tsx,css}\" \"src/core/**/*.ts\" \"tools/*.mjs\" \"*.{json,mts,html}\"",
    "format:fix": "yarn prettier:fix",
    "format:ci": "yarn lint && prettier --check \"src/react/**/*.{ts,tsx,css}\" \"src/core/**/*.ts\" \"tools/*.mjs\" \"*.{json,mts,html}\""
  },
  "private": true,
  "dependencies": {
    "@ai-sdk/openai": "2.0.67",
    "@bufbuild/protobuf": "2.12.0",
    "@codingame/monaco-vscode-api": "37.6.1",
    "@codingame/monaco-vscode-editor-api": "37.6.1",
    "@codingame/monaco-vscode-java-default-extension": "37.6.1",
    "@codingame/monaco-vscode-python-default-extension": "37.6.1",
    "@codingame/monaco-vscode-textmate-service-override": "37.6.1",
    "@lezer/python": "1.1.19",
    "ai": "5.0.93",
    "ajv": "8.18.0",
    "concaveman": "2.0.0",
    "d3-shape": "2.1.0",
    "dagre": "0.8.5",
    "dompurify": "3.4.17",
    "fuse.js": "7.5.0",
    "graphlib": "2.1.8",
    "html2canvas": "1.4.1",
    "jointjs": "3.5.4",
    "jszip": "3.10.1",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "marked": "17.0.1",
    "monaco-breakpoints": "0.2.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@37.6.1",
    "monaco-languageclient": "11.0.3",
    "papaparse": "5.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "read-excel-file": "5.7.1",
    "rxjs": "7.8.2",
    "uuid": "14.0.1",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "y-websocket": "1.5.4",
    "yjs": "13.6.31",
    "zod": "3.25.76"
  },
  "resolutions": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@37.6.1",
