        "code": "from pytexera import *\nfrom sklearn.preprocessing import StandardScaler\n\n\nclass ProcessTableOperator(UDFTableOperator):\n\n    @overrides\n    def process_table(self, table: Table, port: int) -> Iterator[Optional[TableLike]]:\n        # Stand-in for a real source with gaps: every 7th rating is missing.\n        table.loc[table.index % 7 == 0, \"vote_average\"] = float(\"nan\")\n\n        # BROKEN ON PURPOSE: StandardScaler rejects missing values.\n        # The fix is a .dropna() (or a fillna) before scaling.\n        # Raises: ValueError: Input contains NaN.\n        table[\"rating_z\"] = StandardScaler().fit_transform(table[[\"vote_average\"]])\n\n        yield table\n",
